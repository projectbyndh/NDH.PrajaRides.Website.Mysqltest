# Postgres connection string (special characters in the password must be URL-encoded, e.g. @ → %40, # → %23).
# In production add ?sslmode=require (the database server must have SSL enabled).
DATABASE_URL=postgres://user:password@host:5432/dbname

# S3-compatible object storage (Contabo) for every image on the site
OBJECT_STORAGE_ENDPOINT=https://eu2.contabostorage.com
OBJECT_STORAGE_BUCKET=your-bucket
OBJECT_STORAGE_BASE_PREFIX=nepcab
OBJECT_STORAGE_REGION=eu2
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Signs driver login cookies: a long random string (falls back to ADMIN_PASSWORD if unset)
SESSION_SECRET=a-long-random-string

# Public address of the site: QR codes, shared links, sitemap. Set before the first production build.
NEXT_PUBLIC_SITE_URL=

# Where the server keeps its copy of object storage reads, and photos still waiting to be uploaded.
# Both default to a path inside the app's own folder, which is right for a VPS. On a managed host
# that deploys each release into a new directory (Hostinger builds into hbuilds/versions/<id>/),
# set them to a fixed path OUTSIDE that directory: otherwise the image cache starts empty after
# every deploy, so every image is fetched from object storage again (slow), and photos queued for
# upload are left behind in the previous release's folder.
# STORAGE_CACHE_DIR=/home/<user>/domains/<domain>/storage-cache
# STORAGE_PENDING_DIR=/home/<user>/domains/<domain>/pending-uploads
# Cap for that image cache in MB (default 2048). Lower it on a plan with a small disk quota.
# STORAGE_CACHE_MAX_MB=256

# Optional: how long to wait for the database to accept a connection, in seconds (default 8), and
# how long a failed attempt is remembered before trying again, in milliseconds (default 30000).
# Both are bounded on purpose: a database host that drops packets instead of refusing them would
# otherwise stall a page past nginx's limit and the site would answer 504 (see README → Deploy).
# DATABASE_CONNECT_TIMEOUT=8
# DATABASE_RETRY_AFTER_MS=30000

# Optional: lets /api/db-check (which names the database error) be read from off the server with
# ?token=<this>. Without it that page answers only to requests made on the server itself.
# DIAGNOSTICS_TOKEN=

# Optional: send Android/iOS riders straight to the store instead of the landing page
# AUTO_REDIRECT=true

# Optional: override store URLs / add Apple provider token for App Store campaign analytics
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.nepcab.user
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/np/app/nepcab/id6746757374
# NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
